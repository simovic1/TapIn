# Frontend dev settings (copy to .env.local if you need to change them; .env.local is git-ignored).
# Backend URL the Vite dev server proxies /api, /actuator and Swagger to.
VITE_BACKEND_URL=http://localhost:8080
# Prism mock server used by `npm run dev:mock` (start it with `npm --prefix ../api run mock`).
VITE_MOCK_URL=http://127.0.0.1:4010

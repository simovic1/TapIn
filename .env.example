# Local development overrides for docker-compose.yml.
# Copy to `.env` (git-ignored). Every value is optional: the defaults already match application-local.yml.
# Never commit real credentials; staging/production secrets live in the deployment environment only.

DB_NAME=tapin
DB_USER=tapin
DB_PASSWORD=tapin
DB_PORT=5432

MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

CLUB_NAME=BJJ klub (local)

# ---------------------------------------------------------------------------
# Variables required by the backend in staging/prod (SPRING_PROFILES_ACTIVE=staging|prod).
# Set them in the deployment environment / secret store, NOT in this file:
#   DB_URL, DB_USER, DB_PASSWORD
#   MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_FROM
#   CLUB_NAME

# Local development overrides for docker-compose.yml.
# Copy to `.env` (git-ignored). Every value is optional: the defaults already match application-local.yml.
# Never commit real credentials; staging/production secrets live in the deployment environment only.

DB_NAME=tapin
DB_USER=tapin
DB_PASSWORD=tapin
DB_PORT=5432

MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# Real SMTP delivery (Docker backend reads these from .env).
# Replace the example host and addresses with the provider's actual values.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=your-smtp-username
# MAIL_PASSWORD='your-smtp-password'
# MAIL_FROM=no-reply@example.com
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_SSL=false
# For implicit TLS (usually port 465): MAIL_SSL=true and MAIL_STARTTLS=false.
# APP_BASE_URL=https://your-public-app.example.com
# Localhost links can only be opened on the computer running TapIn.
# MAIL_PROVIDER=smtp

CLUB_NAME=BJJ klub (local)

# First administrator for the local profile (defaults: admin@tapin.local / local-dev-admin-password).
# ADMIN_EMAIL=admin@tapin.local
# ADMIN_PASSWORD=local-dev-admin-password

# ---------------------------------------------------------------------------
# Variables required by the backend in staging/prod (SPRING_PROFILES_ACTIVE=staging|prod).
# Set them in the deployment environment / secret store, NOT in this file:
#   DB_URL, DB_USER, DB_PASSWORD
#   MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_FROM, MAIL_PROVIDER (smtp | log)
#   CLUB_NAME
#   APP_BASE_URL (javni HTTPS origin aplikacije, npr. https://tapin.example.hr – za poveznice u e-mailovima)
#   ADMIN_EMAIL, ADMIN_PASSWORD (min. 12 znakova; samo za prvo pokretanje dok ne postoji aktivni administrator,
#                                zatim ukloniti ADMIN_PASSWORD iz okruženja), ADMIN_FIRST_NAME, ADMIN_LAST_NAME
